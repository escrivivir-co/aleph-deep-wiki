        {
            "language": "markdown",
            "source": [
                "## Verificación final\n\nRecuento de chunks por colección `mo_mapas_*` y total acumulado `mod-onfalo`."
            ],
            "outputs": []
        },
        {
            "language": "typescript",
            "source": [
                "// ── Celda 16: Verificación final ───────────────────────────────────────────────\nconst allCols = await client.listCollections();\n// listCollections puede devolver string[] o {name:string}[] según versión chromadb\nconst getName = (c) => typeof c === 'string' ? c : c.name;\nconst mapasCols = allCols.filter(c => getName(c).startsWith('mo_mapas_'));\nconst onfaloTotal_cols = allCols.filter(c => getName(c).startsWith('mo_'));\n\nconsole.log('=== mod-onfalo / MAPAS_DE_SINGULARIDAD ===');\nlet mapasTot = 0;\nfor (const c of mapasCols.sort((a, b) => getName(a).localeCompare(getName(b)))) {\n  const col = await client.getCollection({ name: getName(c) });\n  const n = await col.count();\n  mapasTot += n;\n  console.log(`  ${getName(c).padEnd(35)}  ${String(n).padStart(4)} chunks`);\n}\nconsole.log(`  ${'MAPAS TOTAL'.padEnd(35)}  ${String(mapasTot).padStart(4)} chunks`);\n\nconsole.log('');\nconsole.log('=== mod-onfalo / ACUMULADO ===');\nlet globalTot = 0;\nfor (const c of onfaloTotal_cols.sort((a, b) => getName(a).localeCompare(getName(b)))) {\n  const col = await client.getCollection({ name: getName(c) });\n  const n = await col.count();\n  globalTot += n;\n  console.log(`  ${getName(c).padEnd(35)}  ${String(n).padStart(4)} chunks`);\n}\nconsole.log(`  ${'TOTAL mo_*'.padEnd(35)}  ${String(globalTot).padStart(4)} chunks`);"
            ],
            "outputs": [
