            "language": "typescript",
            "source": [
                "// ── Celda nueva: VM SDK desde mcp-core-sdk — vendor-first ───────────────────\nconst vmCorePathLib = require('path');\n\nconst vmCoreHome = process.env.HOME || process.env.USERPROFILE;\nif (!vmCoreHome) {\n  throw new Error('HOME / USERPROFILE is required to resolve mcp-core-sdk paths.');\n}\n\nconst vmCoreRepoRoot = vmCorePathLib.join(vmCoreHome, 'OASIS', 'aleph-scriptorium');\nconst vmCoreVectorDbDist = vmCorePathLib.join(\n  vmCoreRepoRoot,\n  'MCPGallery',\n  'mcp-core-sdk',\n  'dist',\n  'vector-db'\n);\n\nconst vmCoreExports = require(vmCoreVectorDbDist);\nconst VMCoreBasicVectorMachine = vmCoreExports.BasicVectorMachine;\n\nif (!VMCoreBasicVectorMachine) {\n  throw new Error(\n    `BasicVectorMachine no encontrado en ${vmCoreVectorDbDist}. Ejecuta npm run build en MCPGallery/mcp-core-sdk.`\n  );\n}\n\nconst vmCoreGlobal = globalThis as any;\nconst vmCore = vmCoreGlobal.__vmCore || new VMCoreBasicVectorMachine();\nvmCoreGlobal.__vmCore = vmCore;\n\nfunction getVmCoreEndpoint(chroma: any): string {\n  if (chroma.path) return chroma.path;\n  const protocol = chroma.ssl ? 'https' : 'http';\n  return `${protocol}://${chroma.host}:${chroma.port}`;\n}\n\ntry {\n  const vmCoreHeartbeat = await vmCore.connectChroma();\n  const vmCoreCollections = await vmCore.listCollectionNames('mo_mapas_');\n\n  console.log(`🧭 CORE heartbeat: ${vmCoreHeartbeat}`);\n  console.log('Colecciones mo_mapas_* desde mcp-core-sdk/vector-db:', vmCoreCollections);\n} catch (error) {\n  const vmCoreConfig = vmCore.getConfig();\n  const vmCoreEndpoint = getVmCoreEndpoint(vmCoreConfig.chroma);\n  const message = error instanceof Error ? error.message : String(error);\n  console.warn(`⚠️ No se pudo conectar a Chroma en ${vmCoreEndpoint}: ${message}`);\n}\n\nconsole.log('CORE_CONFIG:', vmCore.getConfig());\n\nvmCore.start();\n\nsetTimeout(function() { vmCore.pause(); }, 1000);\nsetTimeout(function() { vmCore.resume(); }, 1800);\nsetTimeout(function() { vmCore.stop(); }, 2800);\nsetTimeout(function() { console.log('Final core status:', vmCore.getStatus()); }, 3200);\n\nvoid 0;\n"
