        {
            "language": "typescript",
            "source": [
                "// ── Celda 16: Exportar a GH Pages — 100% JS (js-yaml + fs, sin Python) ───────\r\nconst yaml = require(path.join(NNB_DIR, 'node_modules', 'js-yaml'));\r\n\r\nconst EXPORT_DIR = path.join(\r\n  process.env.HOME || process.env.USERPROFILE,\r\n  'OASIS', 'aleph-scriptorium', 'DocumentMachineSDK', 'docs', 'onfalo', 'cuadernos'\r\n);\r\nconst DATA_FILE = path.join(\r\n  process.env.HOME || process.env.USERPROFILE,\r\n  'OASIS', 'aleph-scriptorium', 'DocumentMachineSDK', 'docs', '_data', 'cuadernos_onfalo.yml'\r\n);\r\n\r\nfs.mkdirSync(EXPORT_DIR, { recursive: true });\r\nfs.mkdirSync(path.dirname(DATA_FILE), { recursive: true });\r\n\r\nconst TODAY = new Date().toISOString().slice(0, 10);\r\n\r\nconst exports = [\r\n  {\r\n    id:          'mapas_2d',\r\n    filename:    'mapas_2d.html',\r\n    title:       'MAPAS — Espacio 2D',\r\n    descripcion: 'Proyección UMAP 2D de MAPAS_DE_SINGULARIDAD. Paleta índigo — mod/onfalo.',\r\n    html:        globalThis._msHtml2d ?? '',\r\n  },\r\n  {\r\n    id:          'mapas_3d',\r\n    filename:    'mapas_3d.html',\r\n    title:       'MAPAS — Espacio 3D',\r\n    descripcion: 'Proyección UMAP 3D rotable de MAPAS_DE_SINGULARIDAD.',\r\n    html:        globalThis._msHtml3d ?? '',\r\n  },\r\n  {\r\n    id:          'mapas_clusters',\r\n    filename:    'mapas_clusters.html',\r\n    title:       `MAPAS — Clusters semánticos (K=${globalThis._msBestK ?? '?'})`,\r\n    descripcion: `Agrupación K-means sobre MAPAS_DE_SINGULARIDAD (K=${globalThis._msBestK ?? '?'}).`,\r\n    html:        globalThis._msHtmlClusters ?? '',\r\n  },\r\n];\r\n\r\n// ── Escribir HTMLs ─────────────────────────────────────────────────────────────\r\nconsole.log('=== Exportación GH Pages ===');\r\nfor (const e of exports) {\r\n  const dest = path.join(EXPORT_DIR, e.filename);\r\n  const fullHtml = `<!DOCTYPE html><html><head><meta charset=\"UTF-8\"/><title>${e.title}</title></head><body style=\"margin:0;background:#07101f;\">${e.html}</body></html>`;\r\n  fs.writeFileSync(dest, fullHtml, 'utf-8');\r\n  const sizeKb = Math.round(fs.statSync(dest).size / 1024);\r\n  console.log(`  ✓ ${e.filename.padEnd(30)} ${sizeKb} KB`);\r\n}\r\n\r\n// ── Actualizar cuadernos_onfalo.yml (incremental, no toca otras entradas) ─────\r\nlet existing: any[] = [];\r\nif (fs.existsSync(DATA_FILE)) {\r\n  const noComments = fs.readFileSync(DATA_FILE, 'utf-8')\r\n    .split('\\n').filter((l: string) => !l.startsWith('#')).join('\\n');\r\n  try { existing = (yaml.load(noComments) as any[]) || []; } catch { existing = []; }\r\n}\r\n\r\nconst nuevosIds = new Set(exports.map(e => e.id));\r\nconst registrosBase = existing.filter((r: any) => !nuevosIds.has(r.id));\r\nconst registrosNuevos = exports.map(e => ({\r\n  id:          e.id,\r\n  title:       e.title,\r\n  file:        `onfalo/cuadernos/${e.filename}`,\r\n  descripcion: e.descripcion,\r\n  fecha:       TODAY,\r\n  colecciones: 'Corpus [MS] · Geopolítica [MS] · Arquitectura [MS] · Abstract [MS]',\r\n}));\r\n\r\nconst registrosFinales = [...registrosBase, ...registrosNuevos];\r\nconst header = '# Cuadernos vectoriales — mod/onfalo\\n# Generado automáticamente. No editar a mano.\\n\\n';\r\nfs.writeFileSync(DATA_FILE, header + yaml.dump(registrosFinales, { allowUnicode: true, sortKeys: false }), 'utf-8');\r\n\r\nconsole.log(`\\n  cuadernos_onfalo.yml → ${registrosFinales.length} entradas totales`);\r\nconsole.log(`  Destino: ${EXPORT_DIR}`);"
            ],
            "outputs": []
