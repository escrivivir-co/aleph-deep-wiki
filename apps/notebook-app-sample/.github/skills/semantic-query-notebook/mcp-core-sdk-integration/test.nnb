            "language": "markdown",
            "source": [
                "# Corpus Visualizer — mod/onfalo · MAPAS_DE_SINGULARIDAD\r\n\r\n**Tenant:** `scriptorium` · **Database:** `mod-onfalo` · **Paleta:** índigo azul\r\n\r\nProyecta los embeddings de las 4 colecciones `mo_mapas_*` en 2D/3D usando UMAP.\r\n\r\n| Colección | Contenido |\r\n|-----------|----------|\r\n| `mo_mapas_corpus` | Ensayo fundacional: lengua × geopolítica × arquitectura |\r\n| `mo_mapas_geopolitica` | Las 3 puertas: contaminación, multimodalidad, espejo |\r\n| `mo_mapas_arquitectura` | Transformer, Mamba, Jamba — epistemología |\r\n| `mo_mapas_abstract` | Cuarta dimensión: el modelo que no sabe que no ve |\r\n\r\n---\r\n\r\n> ⚠️ **PRERREQUISITO** — Chroma HTTP Server en `:8000`  \r\n> Usa la tarea `VMS: Start [Chroma]` o `bash start.sh` antes de ejecutar.\r\n\r\n**Flujo ANTIGUO:** celda 2 → 3 → 4 → 6 → 8 → 10 → 12 → 14 → 16 (export GH Pages)"
            ],
            "outputs": []
        },
        {
            "language": "typescript",
            "source": [
                "// VM SDK TYPED\r\n\r\ntype ChromaCollectionLike = string | { name: string };\r\n\r\ntype ChromaClientOptions = {\r\n    path?: string;\r\n    tenant?: string;\r\n    database?: string;\r\n    fetchOptions?: Record<string, unknown>;\r\n    auth?: Record<string, unknown>;\r\n};\r\n\r\ninterface ChromaClientLike {\r\n    heartbeat(): Promise<number>;\r\n    listCollections(): Promise<ChromaCollectionLike[]>;\r\n}\r\n\r\ntype ChromaClientConstructor = new (params?: ChromaClientOptions) => ChromaClientLike;\r\n\r\ninterface VectorMachineEnv extends NodeJS.ProcessEnv {\r\n    HOME?: string;\r\n    USERPROFILE?: string;\r\n    VECTOR_MACHINE_REPO_ROOT?: string;\r\n    VECTOR_MACHINE_CHROMA_PATH?: string;\r\n    VECTOR_MACHINE_CHROMA_TENANT?: string;\r\n    VECTOR_MACHINE_CHROMA_DATABASE?: string;\r\n    VECTOR_MACHINE_COLLECTION_PREFIX?: string;\r\n}\r\n\r\ntype MachineStatus = 'idle' | 'running' | 'paused' | 'stopped';\r\n\r\ninterface ResolvedChromaConfig {\r\n    path: string;\r\n    tenant: string;\r\n    database: string;\r\n    fetchOptions?: Record<string, unknown>;\r\n    auth?: Record<string, unknown>;\r\n}\r\n\r\ninterface VectorMachineConfig {\r\n    repoRoot: string;\r\n    sdkRoot: string;\r\n    collectionPrefix: string;\r\n    chroma: ResolvedChromaConfig;\r\n}\r\n\r\ninterface VectorMachine {\r\n    start(): void;\r\n    pause(): void;\r\n    resume(): void;\r\n    stop(): void;\r\n    getStatus(): MachineStatus;\r\n    getConfig(): VectorMachineConfig;\r\n    getChromaClient(): ChromaClientLike;\r\n    connectChroma(): Promise<number>;\r\n    listCollectionNames(prefix?: string): Promise<string[]>;\r\n}\r\n\r\ntype NotebookGlobalState = typeof globalThis & {\r\n    __vm?: BasicVectorMachine;\r\n};\r\n\r\nconst chromadbModule = await import('chromadb');\r\nconst path = await import('path');\r\nconst RuntimeChromaClient = chromadbModule.ChromaClient as unknown as ChromaClientConstructor;\r\nconst ENV = process.env as VectorMachineEnv;\r\n\r\nfunction resolveHomeDirectory(env: VectorMachineEnv): string {\r\n    const homeDirectory = env.HOME || env.USERPROFILE;\r\n    if (!homeDirectory) {\r\n        throw new Error('HOME / USERPROFILE is required to resolve VectorMachineSDK paths.');\r\n    }\r\n    return homeDirectory;\r\n}\r\n\r\nfunction resolveRepoRoot(env: VectorMachineEnv): string {\r\n    return env.VECTOR_MACHINE_REPO_ROOT ||\r\n        path.join(resolveHomeDirectory(env), 'OASIS', 'aleph-scriptorium');\r\n}\r\n\r\nfunction resolveCollectionName(collection: ChromaCollectionLike): string {\r\n    return typeof collection === 'string' ? collection : collection.name;\r\n}\r\n\r\nconst repoRoot = resolveRepoRoot(ENV);\r\n\r\nconst DEFAULT_CONFIG: VectorMachineConfig = {\r\n    repoRoot: repoRoot,\r\n    sdkRoot: path.join(repoRoot, 'VectorMachineSDK'),\r\n    collectionPrefix: ENV.VECTOR_MACHINE_COLLECTION_PREFIX || 'mo_mapas_',\r\n    chroma: {\r\n        path: ENV.VECTOR_MACHINE_CHROMA_PATH || 'http://localhost:8000',\r\n        tenant: ENV.VECTOR_MACHINE_CHROMA_TENANT || 'default_tenant',\r\n        database: ENV.VECTOR_MACHINE_CHROMA_DATABASE || 'default_database',\r\n    },\r\n};\r\n\r\nclass BasicVectorMachine implements VectorMachine {\r\n    private status: MachineStatus;\r\n    private tick: number;\r\n    private timer: NodeJS.Timeout | null;\r\n    private config: VectorMachineConfig;\r\n    private chromaClient: ChromaClientLike;\r\n\r\n    constructor(config?: VectorMachineConfig) {\r\n        this.status = 'idle';\r\n        this.tick = 0;\r\n        this.timer = null;\r\n        this.config = config || DEFAULT_CONFIG;\r\n        this.chromaClient = new RuntimeChromaClient(this.config.chroma);\r\n    }\r\n\r\n    public start(): void {\r\n        if (this.status === 'running') return;\r\n        if (this.status === 'paused') {\r\n            throw new Error('Use resume() when machine is paused.');\r\n        }\r\n\r\n        this.tick = 0;\r\n        this.status = 'running';\r\n        this.runLoop();\r\n        console.log('▶️ VectorMachine started');\r\n    }\r\n\r\n    public pause(): void {\r\n        if (this.status !== 'running') {\r\n            throw new Error(`Cannot pause from state \"${this.status}\".`);\r\n        }\r\n        this.status = 'paused';\r\n        this.clearLoop();\r\n        console.log('⏸️ VectorMachine paused');\r\n    }\r\n\r\n    public resume(): void {\r\n        if (this.status !== 'paused') {\r\n            throw new Error(`Cannot resume from state \"${this.status}\".`);\r\n        }\r\n        this.status = 'running';\r\n        this.runLoop();\r\n        console.log('⏯️ VectorMachine resumed');\r\n    }\r\n\r\n    public stop(): void {\r\n        if (this.status === 'idle' || this.status === 'stopped') return;\r\n        this.status = 'stopped';\r\n        this.clearLoop();\r\n        console.log(`⏹️ VectorMachine stopped at tick ${this.tick}`);\r\n    }\r\n\r\n    public getStatus(): MachineStatus {\r\n        return this.status;\r\n    }\r\n\r\n    public getConfig(): VectorMachineConfig {\r\n        return this.config;\r\n    }\r\n\r\n    public getChromaClient(): ChromaClientLike {\r\n        return this.chromaClient;\r\n    }\r\n\r\n    public async connectChroma(): Promise<number> {\r\n        return await this.chromaClient.heartbeat();\r\n    }\r\n\r\n    public async listCollectionNames(prefix?: string): Promise<string[]> {\r\n        const collectionPrefix = prefix || this.config.collectionPrefix;\r\n        const collections = await this.chromaClient.listCollections();\r\n        return collections\r\n            .map(resolveCollectionName)\r\n            .filter(function(collectionName: string): boolean {\r\n                return collectionName.indexOf(collectionPrefix) === 0;\r\n            });\r\n    }\r\n\r\n    private runLoop(): void {\r\n        const self = this;\r\n        this.clearLoop();\r\n        this.timer = setInterval(function() {\r\n            self.tick += 1;\r\n            console.log(`tick=${self.tick} | status=${self.status}`);\r\n        }, 300);\r\n    }\r\n\r\n    private clearLoop(): void {\r\n        if (this.timer) {\r\n            clearInterval(this.timer);\r\n            this.timer = null;\r\n        }\r\n    }\r\n}\r\n\r\n// Sample start-pause-resume-stop cycle + Chroma bootstrap\r\nconst notebookGlobal = globalThis as NotebookGlobalState;\r\nconst vm = notebookGlobal.__vm || new BasicVectorMachine();\r\nnotebookGlobal.__vm = vm;\r\n\r\ntry {\r\n    const heartbeat = await vm.connectChroma();\r\n    const chromaCollections = await vm.listCollectionNames();\r\n\r\n    console.log(`🧭 Chroma heartbeat: ${heartbeat}`);\r\n    console.log(`Colecciones ${vm.getConfig().collectionPrefix} disponibles:`, chromaCollections);\r\n} catch (error) {\r\n    const message = error instanceof Error ? error.message : String(error);\r\n    console.warn(`⚠️ No se pudo conectar a Chroma en ${vm.getConfig().chroma.path}: ${message}`);\r\n}\r\n\r\nconsole.log('DEFAULT_CONFIG:', vm.getConfig());\r\n\r\nvm.start();\r\n\r\nsetTimeout(function() { vm.pause(); }, 1000);\r\nsetTimeout(function() { vm.resume(); }, 1800);\r\nsetTimeout(function() { vm.stop(); }, 2800);\r\nsetTimeout(function() { console.log('Final status:', vm.getStatus()); }, 3200);\r\n\r\nvoid 0;"
            ],
